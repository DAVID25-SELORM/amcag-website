rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function userRole() {
      return signedIn() ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role : '';
    }
    function isExecutive() {
      return userRole() in ['super_admin', 'national_executive', 'regional_executive'];
    }
    
    // Profile pictures (new users uploading during registration)
    match /profile-pictures/{allPaths=**} {
      allow read: if true; // Public read for profile pictures
      allow write: if signedIn() &&
                      request.resource.size < 5 * 1024 * 1024 && // 5MB limit
                      request.resource.contentType.matches('image/.*'); // Only images
    }
    
    // Media uploads (authenticated users, public read)
    match /media/photos/{allPaths=**} {
      allow read: if true; // Public read
      allow write: if signedIn() && isExecutive() &&
                      request.resource.size < 5 * 1024 * 1024 && // 5MB limit for photos
                      request.resource.contentType.matches('image/.*'); // Only images
    }
    
    match /media/videos/{allPaths=**} {
      allow read: if true; // Public read
      allow write: if signedIn() && isExecutive() &&
                      request.resource.size < 100 * 1024 * 1024; // 100MB limit for videos
    }
    
    // Donation campaign images (selected executives are enforced when the campaign is saved)
    match /campaign-images/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && isExecutive() && request.auth.uid == userId &&
                      request.resource.size < 5 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/.*');
    }

    // Images for news, leadership and other dashboard-managed pages
    match /site-images/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && isExecutive() && request.auth.uid == userId &&
                      request.resource.size < 5 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/.*');
    }

    // Profile pictures (legacy path)
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() &&
                       (request.auth.uid == userId || isExecutive()) &&
                       request.resource.size < 5 * 1024 * 1024 &&
                       request.resource.contentType.matches('image/.*');
    }
    
    // Certificates (restricted write, public read for verification)
    match /certificates/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && userRole() in ['super_admin', 'national_executive'];
    }
    
    // Documents (authenticated read, admin write)
    match /documents/{allPaths=**} {
      allow read: if signedIn() && isExecutive();
      allow write: if signedIn() && userRole() in ['super_admin', 'national_executive'];
    }
    
    // Donation receipts (PDF files)
    match /donation-receipts/{donationId}/{allPaths=**} {
      // Read: Donors can read their own receipts, regional/national execs can read all
      allow read: if signedIn() && (isExecutive() ||
        firestore.get(/databases/(default)/documents/donations/$(donationId)).data.uid == request.auth.uid);
      allow write: if signedIn() && isExecutive();
    }
    
    // Distribution photos
    match /distribution-photos/{donationId}/{allPaths=**} {
      // Read: Public photos readable by all, others by authenticated users
      allow read: if true; // Photos are usually public to show impact
      
      // Write: Regional and national execs can upload photos
      allow write: if signedIn() && isExecutive() &&
                      request.resource.size < 5 * 1024 * 1024 && // 5MB limit per photo
                      request.resource.contentType.matches('image/.*'); // Only images
    }
    
    // Chat attachments
    match /chat-attachments/{region}/{chatType}/{allPaths=**} {
      // Read: Authenticated users in the same region or executives
      allow read: if signedIn() && ((region == 'national' && chatType == 'national' && isExecutive()) ||
        (region != 'national' && (request.auth.token.chat_region_paths[region] == true || request.auth.token.chat_oversight == true)));

      // Write: members of the region (and the national president / PRO / super admin for announcements)
      allow write: if signedIn() &&
                      ((region == 'national' && chatType == 'national' && isExecutive()) ||
                       (region != 'national' && (request.auth.token.chat_region_paths[region] == true ||
                         (request.auth.token.chat_oversight == true && chatType == 'announcement')))) &&
                      request.resource.size < 10 * 1024 * 1024; // 10MB limit
    }
  }
}
